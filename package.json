{
  "name": "recycle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:core": "node scripts/verify-core.js",
    "preview": "vite preview",
    "start": "node server.js",
    "server": "node server.js",
    "prod:check": "npm run lint && npm run build",
    "seed:firestore": "node scripts/seed-firestore.js",
    "export:firestore-seed": "node scripts/seed-firestore.js --export data/firestore-seed.json",
    "ai:train": "powershell -ExecutionPolicy Bypass -File ai/train_model.ps1",
    "ai:auto-retrain": "powershell -ExecutionPolicy Bypass -File ai/auto_retrain.ps1",
    "ai:auto-retrain:watch": "powershell -ExecutionPolicy Bypass -File ai/auto_retrain.ps1 -Watch"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.1.8",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "firebase-admin": "^13.9.0",
    "gsap": "^3.13.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-responsive": "^10.0.1",
    "sweetalert2": "^11.26.24",
    "tailwindcss": "^4.1.8",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "vite": "^6.3.5"
  }
}
