# Firebase browser config. Add these in Vercel Project Settings > Environment Variables.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIRESTORE_DATABASE_ID=(default)

# Optional: use your custom Python TensorFlow API when it is hosted somewhere public.
# Leave empty on Vercel if you want to use api/detect-waste.js with OpenAI instead.
VITE_AI_API_BASE_URL=

# Vercel serverless AI fallback. Keep this secret in Vercel only, not in frontend code.
OPENAI_API_KEY=your_openai_api_key
OPENAI_WASTE_MODEL=gpt-4.1-mini

JWT_SECRET=replace_with_a_long_random_secret_before_production
PORT=3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_BODY_BYTES=32768
